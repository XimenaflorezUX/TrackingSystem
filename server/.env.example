# Copie este archivo a `.env` en la misma carpeta `server/` y complete los valores.
# No suba `.env` al repositorio.

PORT=4000

# ─── Correo ───────────────────────────────────────────────────────────────────
# Si NO define SMTP_USER ni SMTP_PASS, el servidor usa Ethereal.email automáticamente
# (cuenta de prueba + URL de vista previa en la consola tras cada POST /vacancies).
#
# Para SMTP real (p. ej. Gmail con contraseña de aplicación), descomente y complete:

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=contraseña_de_aplicacion
# SMTP_FROM=Tracking System <tu_correo@gmail.com>

# Destinatario del aviso interno (también aplica con Ethereal: el mensaje se captura igualmente)
SMTP_NOTIFICATION_TO=ximenamarilla11@gmail.com

# Opcional: datos JSON (por defecto server/data/vacancies.json)
# VACANCIES_DATA_PATH=

# Opcional: orígenes CORS separados por coma
# CLIENT_ORIGIN=http://localhost:5173
